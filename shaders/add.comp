#version 450
// y = a + b（逐元素），用于 forward/backward 链里的 feat_prop 累加。
layout(local_size_x = 64) in;

layout(binding = 0) readonly buffer A { float a[]; };
layout(binding = 1) readonly buffer B { float b[]; };
layout(binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int C_;
    int H;
    int W;
    int O;
    float slope;
    int k;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const int n = p.H;               // 这里 H 直接当元素个数传
    if (int(i) < n) y[i] = a[i] + b[i];
}
