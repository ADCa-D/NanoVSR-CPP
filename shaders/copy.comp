#version 450
// 纯流式读写：y = x * 1.0001。用来量"这块卡在 Vulkan 下能跑多少 GB/s"，
// 以及确认 GPU 时钟/队列是否正常（卷积慢的时候用来排除硬件层面的怀疑）。
layout(local_size_x = 256) in;

layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int n;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < uint(p.n)) y[i] = x[i] * 1.0001;
}
